//@version=5
indicator("Adaptive Crypto Indicator Pro", shorttitle="ACI Pro", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// =====================================
// INPUT SETTINGS
// =====================================

// Adaptive Trend Module Settings
g_trend = "🔄 Adaptive Trend Module"
kama_length = input.int(14, "KAMA Length", minval=1, maxval=100, group=g_trend)
kama_fast = input.int(2, "KAMA Fast SC", minval=1, maxval=50, group=g_trend)
kama_slow = input.int(30, "KAMA Slow SC", minval=1, maxval=100, group=g_trend)
adx_length = input.int(14, "ADX Length", minval=1, maxval=50, group=g_trend)
adx_threshold = input.int(25, "ADX Threshold", minval=10, maxval=50, group=g_trend)

// Pattern Analysis Settings
g_pattern = "📊 Pattern Analysis"
rsi_length = input.int(14, "RSI Length", minval=5, maxval=50, group=g_pattern)
rsi_overbought = input.int(70, "RSI Overbought", minval=60, maxval=90, group=g_pattern)
rsi_oversold = input.int(30, "RSI Oversold", minval=10, maxval=40, group=g_pattern)
stoch_k = input.int(14, "Stochastic %K", minval=5, maxval=50, group=g_pattern)
stoch_d = input.int(3, "Stochastic %D", minval=1, maxval=10, group=g_pattern)
enable_patterns = input.bool(true, "Enable Candlestick Patterns", group=g_pattern)
volume_threshold = input.float(1.5, "Volume Spike Threshold", minval=1.0, maxval=5.0, step=0.1, group=g_pattern)

// Multi-Timeframe Settings
g_mtf = "⏰ Multi-Timeframe Analysis"
htf_timeframe = input.timeframe("4h", "Higher Timeframe", group=g_mtf)
enable_mtf = input.bool(true, "Enable MTF Analysis", group=g_mtf)
confluence_zones = input.bool(true, "Show Confluence Zones", group=g_mtf)

// Risk Management Settings
g_risk = "⚠️ Risk Management"
atr_length = input.int(14, "ATR Length", minval=5, maxval=50, group=g_risk)
atr_multiplier = input.float(2.0, "ATR Multiplier for Stops", minval=1.0, maxval=5.0, step=0.1, group=g_risk)
tp_ratio = input.float(2.0, "Take Profit Ratio", minval=1.0, maxval=10.0, step=0.1, group=g_risk)
position_size_mode = input.string("Fixed", "Position Size Mode", options=["Fixed", "Volatility Based"], group=g_risk)

// Visualization Settings
g_visual = "🎨 Visualization"
show_trend_zones = input.bool(true, "Show Trend Zones", group=g_visual)
show_sr_levels = input.bool(true, "Show S/R Levels", group=g_visual)
show_signals = input.bool(true, "Show Entry/Exit Signals", group=g_visual)
trend_transparency = input.int(85, "Trend Zone Transparency", minval=50, maxval=95, group=g_visual)

// Alert Settings
g_alerts = "🔔 Alert Settings"
enable_all_alerts = input.bool(true, "Enable All Alerts", group=g_alerts)
alert_long_entry = input.bool(true, "Long Entry Alerts", group=g_alerts)
alert_short_entry = input.bool(true, "Short Entry Alerts", group=g_alerts)
alert_exit_signals = input.bool(true, "Exit Signal Alerts", group=g_alerts)

// =====================================
// CORE CALCULATIONS
// =====================================

// Kaufman's Adaptive Moving Average (KAMA)
kama(src, length, fast_sc, slow_sc) =>
    mom = math.abs(src - src[length])
    vol = math.sum(math.abs(src - src[1]), length)
    er = vol != 0 ? mom / vol : 0
    sc = math.pow((er * (2.0 / (fast_sc + 1) - 2.0 / (slow_sc + 1)) + 2.0 / (slow_sc + 1)), 2)
    var float kama_val = na
    kama_val := na(kama_val[1]) ? src : kama_val[1] + sc * (src - kama_val[1])
    kama_val

// ADX Calculation for Trend Strength
adx_calc(length) =>
    up = ta.change(high)
    down = -ta.change(low)
    plus_dm = na(up) ? na : (up > down and up > 0 ? up : 0)
    minus_dm = na(down) ? na : (down > up and down > 0 ? down : 0)
    range_val = ta.tr
    plus_di = 100 * ta.rma(plus_dm, length) / ta.rma(range_val, length)
    minus_di = 100 * ta.rma(minus_dm, length) / ta.rma(range_val, length)
    dx = math.abs(plus_di - minus_di) / (plus_di + minus_di) * 100
    adx = ta.rma(dx, length)
    [adx, plus_di, minus_di]

// Market Structure Analysis
market_structure() =>
    pivot_high = ta.pivothigh(high, 5, 5)
    pivot_low = ta.pivotlow(low, 5, 5)
    var float last_high = na
    var float last_low = na
    var int trend_direction = 0  // 1 for uptrend, -1 for downtrend, 0 for sideways
    
    if not na(pivot_high)
        if na(last_high) or pivot_high > last_high
            trend_direction := 1
        else
            trend_direction := -1
        last_high := pivot_high
    
    if not na(pivot_low)
        if na(last_low) or pivot_low < last_low
            trend_direction := 1
        else
            trend_direction := -1
        last_low := pivot_low
    
    trend_direction

// Candlestick Pattern Recognition
is_doji() =>
    body_size = math.abs(close - open)
    range_size = high - low
    body_size <= range_size * 0.1

is_hammer() =>
    body_size = math.abs(close - open)
    upper_shadow = high - math.max(close, open)
    lower_shadow = math.min(close, open) - low
    lower_shadow > body_size * 2 and upper_shadow < body_size * 0.5

is_shooting_star() =>
    body_size = math.abs(close - open)
    upper_shadow = high - math.max(close, open)
    lower_shadow = math.min(close, open) - low
    upper_shadow > body_size * 2 and lower_shadow < body_size * 0.5

is_engulfing_bullish() =>
    close > open and close[1] < open[1] and open < close[1] and close > open[1]

is_engulfing_bearish() =>
    close < open and close[1] > open[1] and open > close[1] and close < open[1]

// Volume Analysis
volume_analysis() =>
    vol_ma = ta.sma(volume, 20)
    vol_spike = volume > vol_ma * volume_threshold
    vol_trend = volume > vol_ma
    [vol_spike, vol_trend, vol_ma]

// Support and Resistance Levels
sr_levels() =>
    pivot_high = ta.pivothigh(high, 10, 10)
    pivot_low = ta.pivotlow(low, 10, 10)
    var array<float> resistance_levels = array.new<float>()
    var array<float> support_levels = array.new<float>()
    
    if not na(pivot_high)
        array.push(resistance_levels, pivot_high)
        if array.size(resistance_levels) > 10
            array.shift(resistance_levels)
    
    if not na(pivot_low)
        array.push(support_levels, pivot_low)
        if array.size(support_levels) > 10
            array.shift(support_levels)
    
    [resistance_levels, support_levels]

// =====================================
// MAIN CALCULATIONS
// =====================================

// Calculate KAMA
kama_value = kama(close, kama_length, kama_fast, kama_slow)

// Calculate ADX and DI
[adx_value, plus_di, minus_di] = adx_calc(adx_length)

// Market Structure
market_trend = market_structure()

// Technical Indicators
rsi_value = ta.rsi(close, rsi_length)
[stoch_k_value, stoch_d_value] = ta.stoch(close, high, low, stoch_k)
atr_value = ta.atr(atr_length)

// Volume Analysis
[vol_spike, vol_trend, vol_ma] = volume_analysis()

// Support and Resistance
[resistance_levels, support_levels] = sr_levels()

// Multi-timeframe Analysis
htf_trend = request.security(syminfo.tickerid, htf_timeframe, ta.ema(close, 20) > ta.ema(close, 50))

// =====================================
// SIGNAL GENERATION
// =====================================

// Trend Signals
strong_uptrend = adx_value > adx_threshold and plus_di > minus_di and close > kama_value
strong_downtrend = adx_value > adx_threshold and minus_di > plus_di and close < kama_value
sideways_market = adx_value < adx_threshold

// Pattern Signals
bullish_patterns = (is_hammer() or is_engulfing_bullish()) and enable_patterns
bearish_patterns = (is_shooting_star() or is_engulfing_bearish()) and enable_patterns

// Momentum Signals
rsi_bullish = rsi_value < rsi_oversold and rsi_value > rsi_value[1]
rsi_bearish = rsi_value > rsi_overbought and rsi_value < rsi_value[1]
stoch_bullish = stoch_k_value < 20 and ta.crossover(stoch_k_value, stoch_d_value)
stoch_bearish = stoch_k_value > 80 and ta.crossunder(stoch_k_value, stoch_d_value)

// Volume Confirmation
volume_confirm_bull = vol_trend and close > open
volume_confirm_bear = vol_trend and close < open

// Multi-timeframe Confirmation
mtf_confirm_bull = not enable_mtf or htf_trend
mtf_confirm_bear = not enable_mtf or not htf_trend

// Combined Entry Signals
long_signal = strong_uptrend and (bullish_patterns or rsi_bullish or stoch_bullish) and volume_confirm_bull and mtf_confirm_bull
short_signal = strong_downtrend and (bearish_patterns or rsi_bearish or stoch_bearish) and volume_confirm_bear and mtf_confirm_bear

// Exit Signals
long_exit = ta.crossunder(close, kama_value) or rsi_value > rsi_overbought
short_exit = ta.crossover(close, kama_value) or rsi_value < rsi_oversold

// Risk Management Calculations
long_stop = close - atr_value * atr_multiplier
short_stop = close + atr_value * atr_multiplier
long_tp = close + atr_value * atr_multiplier * tp_ratio
short_tp = close - atr_value * atr_multiplier * tp_ratio

// Position Size Calculation
volatility_factor = atr_value / close
position_multiplier = position_size_mode == "Volatility Based" ? 1 / volatility_factor : 1

// =====================================
// VISUALIZATION
// =====================================

// Plot KAMA
plot(kama_value, "KAMA", color=color.blue, linewidth=2)

// Trend Zone Background
uptrend_color = color.new(color.green, trend_transparency)
downtrend_color = color.new(color.red, trend_transparency)
sideways_color = color.new(color.yellow, trend_transparency)

bgcolor(show_trend_zones and strong_uptrend ? uptrend_color : 
         show_trend_zones and strong_downtrend ? downtrend_color : 
         show_trend_zones and sideways_market ? sideways_color : na, 
         title="Trend Zones")

// Entry/Exit Signals
plotshape(show_signals and long_signal, "Long Entry", shape.triangleup, location.belowbar, 
          color=color.green, size=size.normal)
plotshape(show_signals and short_signal, "Short Entry", shape.triangledown, location.abovebar, 
          color=color.red, size=size.normal)
plotshape(show_signals and long_exit, "Long Exit", shape.xcross, location.abovebar, 
          color=color.orange, size=size.small)
plotshape(show_signals and short_exit, "Short Exit", shape.xcross, location.belowbar, 
          color=color.orange, size=size.small)

// Support and Resistance Levels
if show_sr_levels and barstate.islast
    for i = 0 to array.size(resistance_levels) - 1
        level = array.get(resistance_levels, i)
        line.new(bar_index - 100, level, bar_index, level, 
                 color=color.red, style=line.style_dashed, width=1)
    
    for i = 0 to array.size(support_levels) - 1
        level = array.get(support_levels, i)
        line.new(bar_index - 100, level, bar_index, level, 
                 color=color.green, style=line.style_dashed, width=1)

// Risk Management Lines
var line long_stop_line = na
var line long_tp_line = na
var line short_stop_line = na
var line short_tp_line = na

if long_signal
    line.delete(long_stop_line)
    line.delete(long_tp_line)
    long_stop_line := line.new(bar_index, long_stop, bar_index + 10, long_stop, 
                               color=color.red, style=line.style_solid, width=2)
    long_tp_line := line.new(bar_index, long_tp, bar_index + 10, long_tp, 
                             color=color.green, style=line.style_solid, width=2)

if short_signal
    line.delete(short_stop_line)
    line.delete(short_tp_line)
    short_stop_line := line.new(bar_index, short_stop, bar_index + 10, short_stop, 
                                color=color.red, style=line.style_solid, width=2)
    short_tp_line := line.new(bar_index, short_tp, bar_index + 10, short_tp, 
                              color=color.green, style=line.style_solid, width=2)

// =====================================
// INDICATOR PANELS
// =====================================

// ADX Panel
adx_color = adx_value > adx_threshold ? color.green : color.gray
plot(adx_value, "ADX", color=adx_color, display=display.data_window)
hline(adx_threshold, "ADX Threshold", color=color.gray, linestyle=hline.style_dashed)

// RSI Panel
rsi_color = rsi_value > rsi_overbought ? color.red : 
            rsi_value < rsi_oversold ? color.green : color.blue
plot(rsi_value, "RSI", color=rsi_color, display=display.data_window)
hline(rsi_overbought, "RSI OB", color=color.red, linestyle=hline.style_dashed)
hline(rsi_oversold, "RSI OS", color=color.green, linestyle=hline.style_dashed)

// Volume Analysis
volume_color = vol_spike ? color.orange : vol_trend ? color.blue : color.gray
plot(volume, "Volume", color=volume_color, display=display.data_window)

// =====================================
// CONFLUENCE ZONES
// =====================================

if confluence_zones
    confluence_bull = strong_uptrend and (rsi_bullish or stoch_bullish) and volume_confirm_bull
    confluence_bear = strong_downtrend and (rsi_bearish or stoch_bearish) and volume_confirm_bear
    
    bgcolor(confluence_bull ? color.new(color.lime, 90) : na, title="Bullish Confluence")
    bgcolor(confluence_bear ? color.new(color.fuchsia, 90) : na, title="Bearish Confluence")

// =====================================
// ALERTS
// =====================================

if enable_all_alerts
    if alert_long_entry and long_signal
        alert("🚀 LONG ENTRY SIGNAL\n" + 
              "Symbol: " + syminfo.ticker + "\n" + 
              "Price: " + str.tostring(close) + "\n" + 
              "Stop Loss: " + str.tostring(long_stop) + "\n" + 
              "Take Profit: " + str.tostring(long_tp) + "\n" + 
              "ADX: " + str.tostring(adx_value, "#.##") + "\n" + 
              "RSI: " + str.tostring(rsi_value, "#.##"), 
              alert.freq_once_per_bar_close)
    
    if alert_short_entry and short_signal
        alert("🔻 SHORT ENTRY SIGNAL\n" + 
              "Symbol: " + syminfo.ticker + "\n" + 
              "Price: " + str.tostring(close) + "\n" + 
              "Stop Loss: " + str.tostring(short_stop) + "\n" + 
              "Take Profit: " + str.tostring(short_tp) + "\n" + 
              "ADX: " + str.tostring(adx_value, "#.##") + "\n" + 
              "RSI: " + str.tostring(rsi_value, "#.##"), 
              alert.freq_once_per_bar_close)
    
    if alert_exit_signals and (long_exit or short_exit)
        alert("⚠️ EXIT SIGNAL\n" + 
              "Symbol: " + syminfo.ticker + "\n" + 
              "Price: " + str.tostring(close) + "\n" + 
              "Signal: " + (long_exit ? "Long Exit" : "Short Exit"), 
              alert.freq_once_per_bar_close)

// =====================================
// TABLE DISPLAY
// =====================================

if barstate.islast
    var table info_table = table.new(position.top_right, 3, 8, bgcolor=color.white, border_width=1)
    
    table.cell(info_table, 0, 0, "Indicator", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 0, "Value", text_color=color.black, text_size=size.small)
    table.cell(info_table, 2, 0, "Status", text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 1, "ADX", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 1, str.tostring(adx_value, "#.##"), text_color=color.black, text_size=size.small)
    table.cell(info_table, 2, 1, adx_value > adx_threshold ? "Strong" : "Weak", 
               text_color=adx_value > adx_threshold ? color.green : color.red, text_size=size.small)
    
    table.cell(info_table, 0, 2, "RSI", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 2, str.tostring(rsi_value, "#.##"), text_color=color.black, text_size=size.small)
    table.cell(info_table, 2, 2, rsi_value > rsi_overbought ? "OB" : rsi_value < rsi_oversold ? "OS" : "Neutral", 
               text_color=rsi_value > rsi_overbought ? color.red : rsi_value < rsi_oversold ? color.green : color.gray, 
               text_size=size.small)
    
    table.cell(info_table, 0, 3, "Trend", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 3, strong_uptrend ? "UP" : strong_downtrend ? "DOWN" : "SIDE", text_color=color.black, text_size=size.small)
    table.cell(info_table, 2, 3, strong_uptrend ? "Bullish" : strong_downtrend ? "Bearish" : "Sideways", 
               text_color=strong_uptrend ? color.green : strong_downtrend ? color.red : color.yellow, 
               text_size=size.small)
    
    table.cell(info_table, 0, 4, "Volume", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 4, vol_spike ? "Spike" : vol_trend ? "High" : "Normal", text_color=color.black, text_size=size.small)
    table.cell(info_table, 2, 4, vol_spike ? "🔥" : vol_trend ? "📈" : "➡️", text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 5, "MTF", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 5, enable_mtf ? (htf_trend ? "Bull" : "Bear") : "Off", text_color=color.black, text_size=size.small)
    table.cell(info_table, 2, 5, enable_mtf ? (htf_trend ? "🟢" : "🔴") : "⚪", text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 6, "Signal", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 6, long_signal ? "LONG" : short_signal ? "SHORT" : "None", text_color=color.black, text_size=size.small)
    table.cell(info_table, 2, 6, long_signal ? "🚀" : short_signal ? "🔻" : "⏳", text_color=color.black, text_size=size.small)
    
    table.cell(info_table, 0, 7, "R/R Ratio", text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 7, str.tostring(tp_ratio, "#.#") + ":1", text_color=color.black, text_size=size.small)
    table.cell(info_table, 2, 7, "⚖️", text_color=color.black, text_size=size.small)

// =====================================
// PERFORMANCE METRICS
// =====================================

// Track signal performance (simplified version for demo)
var int total_signals = 0
var int profitable_signals = 0
var float total_pnl = 0.0

if long_signal or short_signal
    total_signals += 1

// This is a simplified performance tracking - in real trading, you'd need more sophisticated tracking
win_rate = total_signals > 0 ? (profitable_signals / total_signals) * 100 : 0

// =====================================
// END OF INDICATOR
// =====================================